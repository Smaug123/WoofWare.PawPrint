<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageId>WoofWare.PosixKernel</PackageId>
        <Authors>Patrick Stevens</Authors>
        <Copyright>Copyright (c) Patrick Stevens 2026</Copyright>
        <Description>A deterministic, purely functional simulation of a POSIX process: filesystem, file descriptors, sockets, signals, and the Unix platform profile. No I/O and no host reads, so a replay never depends on the machine that produced it.</Description>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Smaug123/WoofWare.PawPrint</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>light.png</PackageIcon>
        <PackageTags>posix;unix;simulation;deterministic;filesystem;sockets;fsharp;woofware</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="UnixError.fs" />
        <Compile Include="UnixPathText.fs" />
        <Compile Include="AbsoluteUnixPath.fs" />
        <Compile Include="UnixPath.fs" />
        <Compile Include="VirtualFileSystem.fs" />
        <Compile Include="FileSystemSeed.fs" />
        <Compile Include="InternetEndpoint.fs" />
        <Compile Include="FileDescriptorRegistry.fs" />
        <Compile Include="UnixTask.fs" />
        <Compile Include="Signal.fs" />
        <Compile Include="SignalState.fs" />
        <Compile Include="SimulatedUnixPlatform.fs" />
        <EmbeddedResource Include="version.json" />
    </ItemGroup>

    <ItemGroup>
        <None Include="logos\light.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!--
        nuget.org renders the packed readme through Markdig with DisableHtml(), which escapes raw
        HTML instead of dropping it, and it does not resolve relative image paths at all. The
        <picture> element that gives GitHub its light/dark logo would therefore appear on the
        package page as literal tags. Pack a copy with that element removed; on nuget.org the logo
        is carried by PackageIcon instead.
    -->
    <Target Name="PackReadmeWithoutLogo" BeforeTargets="_GetPackageFiles">
        <PropertyGroup>
            <_NuGetReadmeDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)nuget-readme</_NuGetReadmeDir>
        </PropertyGroup>
        <MakeDir Directories="$(_NuGetReadmeDir)" />
        <WriteLinesToFile File="$(_NuGetReadmeDir)/README.md"
                          Lines="$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/README.md')), '&lt;picture&gt;[\s\S]*?&lt;/picture&gt;\s*', ''))))"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <!-- Any other raw HTML would reach nuget.org as escaped tags, so refuse to pack it. -->
        <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_NuGetReadmeDir)/README.md')), '(?m)^\s*&lt;[A-Za-z/]'))"
               Text="README.md contains raw HTML other than the &lt;picture&gt; logo element. nuget.org escapes raw HTML rather than rendering it, so that markup would appear on the package page as literal tags: express it in CommonMark instead, or teach the PackReadmeWithoutLogo target to strip it too." />
        <ItemGroup>
            <None Include="$(_NuGetReadmeDir)/README.md" Pack="true" PackagePath="\" />
        </ItemGroup>
    </Target>

</Project>
