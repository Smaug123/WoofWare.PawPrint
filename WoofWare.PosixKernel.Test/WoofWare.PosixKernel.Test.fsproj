    <Compile Include="TestKeventRegistration.fs" />
    <Compile Include="TestKeventWriteData.fs" />
    <Compile Include="TestDarwinPoll.fs" />
    <Compile Include="TestPipeBuffer.fs" />
    <Compile Include="TestPipeBufferCorpus.fs" />
    <Compile Include="TestPipeBufferAgainstHost.fs" />
    <Compile Include="TestPipe.fs" />
    <Compile Include="TestDeliveryLog.fs" />
    <Compile Include="TestLaunchedStreams.fs" />
    <Compile Include="TestSuppliedPipe.fs" />
    <Compile Include="TestBlockingPipe.fs" />
    <Compile Include="TestStreamReaderGone.fs" />
    <Compile Include="TestPipeAgainstHost.fs" />
    <Compile Include="TestSockaddrField.fs" />
    <Compile Include="TestSockaddrLayoutAgainstHost.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `socket(2)` answered for raw arguments, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/socket-arguments.c.
         `TestSocketSyscall` holds `UnixSocket.socket` to it. -->
    <EmbeddedResource Include="socketSyscall\*.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- The order a task took its pending signals in, and which thread took a
         signal sent to the process, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/signal-pick-order.c and
         signal-receiver.c. `TestSignalPickOrder` and `TestSignalReceiver` hold
         `SignalState` to them. -->
    <EmbeddedResource Include="signalOrder\*.txt" />
    <EmbeddedResource Include="signalReceiver\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `epoll_ctl(2)` answered for every cell of the probe's ladder,
         measured on Linux; `TestEpollCtl` holds `UnixPoll.epollCtl` to it. -->
    <EmbeddedResource Include="epollCtl\linux-ladder.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `setresuid(2)`, `setresgid(2)`, `setgroups(2)`, `getresuid(2)` and
         `getresgid(2)` answered, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/setresid.c and embedded
         from beside it. `TestCredentialChange` replays every row. -->
    <!-- connect(2)'s answers for a sockaddr's family and length, measured by
         sockaddr-decoding.c, sockaddr-connect-ladder.c, sockaddr-bind-ladder.c and
         sockaddr-dgram-connect.c, embedded from beside them.
         `TestConnectLadderMeasured`, `TestBindLadderMeasured` and
         `TestConnectDestinationMeasured` replay every row. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-decoding.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-decoding.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-decoding.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-decoding.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-connect-ladder.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-connect-ladder.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-connect-ladder.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-connect-ladder.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-bind-ladder.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-bind-ladder.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-bind-ladder.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-bind-ladder.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-dgram-connect.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-dgram-connect.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-dgram-connect.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-dgram-connect.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-dgram-reconnect.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-dgram-reconnect.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\sockaddr-dgram-reconnect.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.sockaddr-dgram-reconnect.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\setresid.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.setresid.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\setresid.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.setresid.darwin.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `chown(2)`, `lchown(2)` and `fchown(2)` answered, measured per
         flavour by docs/plans/2026-08-23-posix-kernel-extraction/chown-rules.c,
         whose output is embedded from beside it rather than copied.
         `TestOwnerChange` replays every row. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\chown-rules.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.chownRules.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\chown-rules.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.chownRules.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\path-copyin-order.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.pathCopyInOrder.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\path-copyin-order.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.pathCopyInOrder.darwin.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\open-flags.linux-6.12.111-x86_64-root.txt" LogicalName="WoofWare.PosixKernel.Test.openFlags.linuxX64.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\open-flags.linux-6.18.5-aarch64-root.txt" LogicalName="WoofWare.PosixKernel.Test.openFlags.linuxArm64.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\open-flags.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.openFlags.darwin.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What Linux's fs.protected_* sysctls refuse, and what Darwin, which has
         none, does instead, measured by
         docs/plans/2026-08-23-posix-kernel-extraction/protected-sysctls.c,
         whose output is embedded from beside it rather than copied.
         `TestProtectedFiles` replays every row. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\protected-sysctls.linux-6.18.5-aarch64-ext4.txt" LogicalName="WoofWare.PosixKernel.Test.protectedSysctls.linuxExt4.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\protected-sysctls.linux-6.18.5-aarch64-tmpfs.txt" LogicalName="WoofWare.PosixKernel.Test.protectedSysctls.linuxTmpfs.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\protected-sysctls.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.protectedSysctls.darwin.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What Darwin's `kevent(2)` answered to every combination of the arguments
         a wait passes, and what a close does to a sleeper, measured by
         docs/plans/2026-08-23-posix-kernel-extraction/kqueue-kevent.c, whose
         output is embedded from beside it. `TestKqueue` replays it. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\kqueue-kevent.darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.kqueueKevent.darwin.txt" />
    <!-- kevent-register.c's output, measured on Darwin 27.0.0 arm64. `TestKeventMeasured`
         replays it. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\kevent-register.darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.keventRegister.darwin.txt" />
    <!-- kevent-write-data.c's output, measured on Darwin 27.0.0 arm64. `TestKeventWriteData`
         replays it. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\kevent-write-data.darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.keventWriteData.darwin.txt" />
    <!-- poll-darwin.c's output, measured on Darwin 27.0.0 arm64. `TestDarwinPoll`
         replays its answers. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\poll-darwin.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.pollDarwin.darwin.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `copy_file_range(2)` and `ioctl(FICLONE)` answered for every pair of
         descriptor kinds, measured on Linux by
         docs/plans/2026-08-23-posix-kernel-extraction/copy-file-syscalls.c, whose
         output is embedded from beside it rather than copied.
         `TestCopyFileSyscalls` replays both matrices. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\copy-file-syscalls.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.copyFileSyscalls.linux.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `read(2)` and `write(2)` answered on a socket with no peer, for
         every domain, kind and unconnected phase, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/socket-unconnected-transfer.c,
         whose output is embedded from beside it. `TestUnconnectedSocketTransfer`
         holds the rules and the kernel to every row. -->
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\socket-unconnected-transfer.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.socketUnconnectedTransfer.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-08-23-posix-kernel-extraction\socket-unconnected-transfer.darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.socketUnconnectedTransfer.darwin.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a real pipe answered to random non-blocking reads and writes,
         measured per flavour; `TestPipeBufferCorpus` holds `PipeBuffer` to it. -->
    <EmbeddedResource Include="pipeBuffer\*.txt" />
    <!-- What a real pipe held as a reader drained it while one blocking write was
         still filling it, measured per flavour; `TestSuppliedPipe` replays it. -->
    <EmbeddedResource Include="suppliedPipe\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `PathArgument.parse` answered while it still decoded paths as
         UTF-8, recorded by pathArgument/record.fsx from that build.
         `TestUnixPathBytes` holds the byte-valued parse to it. -->
    <EmbeddedResource Include="pathArgument\recorded.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- The socket/epoll differential fuzzer's C interpreter, and the corpus of
         transcripts it has measured against a real Linux kernel. Logical
         resource names follow the assembly, so `TestSocketFuzz` reads these as
         `WoofWare.PosixKernel.Test.socketFuzz*`. -->
    <EmbeddedResource Include="socketFuzz\harness.c" />
    <EmbeddedResource Include="signalFuzz\harness.c" />
    <EmbeddedResource Include="signalFuzzCorpus\*.txt" />
    <EmbeddedResource Include="socketFuzzCorpus\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WoofWare.PosixKernel/WoofWare.PosixKernel.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound the test host's GC heap, so that a runaway property test fails with an
         OutOfMemoryException rather than taking the machine's memory. The value and its reasoning
         are WoofWare.PawPrint.Test.fsproj's; see the comment there. Decimal, 8 GiB. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="8589934592" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.4.0"/>
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0"/>
    <PackageReference Include="FsUnit" Version="7.1.1"/>
    <PackageReference Include="FsCheck" Version="3.3.2" />
    <PackageReference Include="FsCheck.NUnit" Version="3.3.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
  </ItemGroup>

</Project>
