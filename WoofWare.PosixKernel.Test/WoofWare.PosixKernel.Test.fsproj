<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 rather than the library's net8.0: the Nix devshell carries only the
         net10 runtime, so a net8.0 test host has nothing to run on. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HostPlatform.fs" />
    <Compile Include="NewSocket.fs" />
    <Compile Include="TestDarwinReleaseAgainstHost.fs" />
    <Compile Include="TestGcHeapHardLimit.fs" />
    <Compile Include="HostFileSystemType.fs" />
    <Compile Include="ReuseAddress.fs" />
    <Compile Include="PathText.fs" />
    <Compile Include="DirectoryReading.fs" />
    <Compile Include="BindingProbes.fs" />
    <Compile Include="TestUnixTaskTable.fs" />
    <Compile Include="CredentialsGen.fs" />
    <Compile Include="TestCredentials.fs" />
    <Compile Include="TestWakeCondition.fs" />
    <Compile Include="TestUnixWait.fs" />
    <Compile Include="TestUnixProcessState.fs" />
    <Compile Include="TestClock.fs" />
    <Compile Include="TestClockAgainstHost.fs" />
        <Compile Include="TestUnixSystemStep.fs" />
    <Compile Include="TestUnixSystemInitial.fs" />
    <Compile Include="TestUnixSystemInvariants.fs" />
    <Compile Include="TestSocketTable.fs" />
    <Compile Include="TestSocketEventDelivery.fs" />
    <Compile Include="SocketFuzz.fs" />
    <Compile Include="TestSocketFuzz.fs" />
    <Compile Include="TestNoPawPrintReference.fs" />
    <Compile Include="TestPathArgument.fs" />
    <Compile Include="TestUserBuffer.fs" />
    <Compile Include="TestUserBufferCheckAgainstHost.fs" />
    <Compile Include="TestEntropyPool.fs" />
    <Compile Include="TestUnixEntropy.fs" />
    <Compile Include="TestEntropyAgainstHost.fs" />
    <Compile Include="TestFileSystemType.fs" />
    <Compile Include="TestDirectorySize.fs" />
    <Compile Include="TestWithFileSystemAndCurrentDirectory.fs" />
    <Compile Include="TestInodeLifetime.fs" />
    <Compile Include="TestUnixError.fs" />
    <Compile Include="TestUnixByteString.fs" />
    <Compile Include="TestUnixPath.fs" />
    <Compile Include="TestUnixPathBytes.fs" />
    <Compile Include="TestAbsoluteUnixPath.fs" />
    <Compile Include="TestFileSystemSeed.fs" />
    <Compile Include="TestFileDescriptorRegistry.fs" />
    <Compile Include="TestProcessId.fs" />
    <Compile Include="TestSignal.fs" />
    <Compile Include="TestSignalAgainstHost.fs" />
    <Compile Include="TestSignalMaskAgainstHost.fs" />
    <Compile Include="TestSignalState.fs" />
    <Compile Include="TestUnixSignal.fs" />
    <Compile Include="TestDirectoryEnumeration.fs" />
    <Compile Include="TestDirectoryDescription.fs" />
    <Compile Include="TestDirectoryReadAgainstHost.fs" />
    <Compile Include="TestPathCursor.fs" />
    <Compile Include="TestVirtualFileSystem.fs" />
    <Compile Include="TestOpenDirRules.fs" />
    <Compile Include="TestRmDirRules.fs" />
    <Compile Include="TestPosixFadvise.fs" />
    <Compile Include="TestUnlinkRules.fs" />
    <Compile Include="TestRenameRules.fs" />
    <Compile Include="TestResolutionSplit.fs" />
    <Compile Include="TestVirtualFileSystemAgainstHost.fs" />
    <Compile Include="TestBindingAgainstHost.fs" />
    <Compile Include="TestArchitectureFacts.fs" />
    <Compile Include="TestArchitectureAgainstHost.fs" />
    <Compile Include="SocketSweep.fs" />
    <Compile Include="TestSocketSyscall.fs" />
    <Compile Include="TestSocketSyscallAgainstHost.fs" />
    <Compile Include="TestAccept.fs" />
    <Compile Include="TestBind.fs" />
    <Compile Include="TestSockOpt.fs" />
    <Compile Include="TestSockOptAgainstHost.fs" />
    <Compile Include="TestSocketBinding.fs" />
    <Compile Include="TestEphemeralPorts.fs" />
    <Compile Include="TestListen.fs" />
    <Compile Include="TestNonBlocking.fs" />
    <Compile Include="TestConnect.fs" />
    <Compile Include="TestPoll.fs" />
    <Compile Include="TestSocketWait.fs" />
    <Compile Include="TestDatagramDissolve.fs" />
    <Compile Include="TestEpollCtl.fs" />
    <Compile Include="TestPipeBuffer.fs" />
    <Compile Include="TestPipeBufferCorpus.fs" />
    <Compile Include="TestPipeBufferAgainstHost.fs" />
    <Compile Include="TestSockaddrField.fs" />
    <Compile Include="TestSockaddrLayoutAgainstHost.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `socket(2)` answered for raw arguments, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/socket-arguments.c.
         `TestSocketSyscall` holds `UnixSocket.socket` to it. -->
    <EmbeddedResource Include="socketSyscall\*.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `epoll_ctl(2)` answered for every cell of the probe's ladder,
         measured on Linux; `TestEpollCtl` holds `UnixPoll.epollCtl` to it. -->
    <EmbeddedResource Include="epollCtl\linux-ladder.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a real pipe answered to random non-blocking reads and writes,
         measured per flavour; `TestPipeBufferCorpus` holds `PipeBuffer` to it. -->
    <EmbeddedResource Include="pipeBuffer\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `PathArgument.parse` answered while it still decoded paths as
         UTF-8, recorded by pathArgument/record.fsx from that build.
         `TestUnixPathBytes` holds the byte-valued parse to it. -->
    <EmbeddedResource Include="pathArgument\recorded.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- The socket/epoll differential fuzzer's C interpreter, and the corpus of
         transcripts it has measured against a real Linux kernel. Logical
         resource names follow the assembly, so `TestSocketFuzz` reads these as
         `WoofWare.PosixKernel.Test.socketFuzz*`. -->
    <EmbeddedResource Include="socketFuzz\harness.c" />
    <EmbeddedResource Include="socketFuzzCorpus\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WoofWare.PosixKernel/WoofWare.PosixKernel.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound the test host's GC heap, so that a runaway property test fails with an
         OutOfMemoryException rather than taking the machine's memory. The value and its reasoning
         are WoofWare.PawPrint.Test.fsproj's; see the comment there. Decimal, 8 GiB. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="8589934592" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.4.0"/>
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0"/>
    <PackageReference Include="FsUnit" Version="7.1.1"/>
    <PackageReference Include="FsCheck" Version="3.3.2" />
    <PackageReference Include="FsCheck.NUnit" Version="3.3.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
  </ItemGroup>

</Project>
