<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- FS0025 (incomplete match) must stay an error: Implicit.fs is only trustworthy because
         an unclassified opcode fails this build rather than acquiring "cannot raise". -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>3</WarningLevel>
    <NoWarn>$(NoWarn);FS0064;FS3370</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Census.fs" />
    <Compile Include="Escape.fs" />
    <Compile Include="CctorCensus.fs" />
    <Compile Include="Driver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../WoofWare.PawPrint.Semantics/WoofWare.PawPrint.Semantics.fsproj" />
  </ItemGroup>
</Project>
